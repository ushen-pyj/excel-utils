{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excel Utils",
  "version": "0.1.0",
  "identifier": "com.codex.excelutils",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Excel Utils",
        "width": 1500,
        "height": 980,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}